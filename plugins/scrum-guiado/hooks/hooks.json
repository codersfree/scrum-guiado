{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "php \"${CLAUDE_PLUGIN_ROOT}/hooks/contexto-sesion.php\"", "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "php \"${CLAUDE_PLUGIN_ROOT}/hooks/proteger-main.php\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "php \"${CLAUDE_PLUGIN_ROOT}/hooks/recordar-bitacora.php\"", "timeout": 15 } ] }
    ]
  }
}
